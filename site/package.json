{
  "name": "ms-gh-pages",
  "version": "1.0.0",
  "private": true,
  "description": "ms-gh-pages",
  "author": "Morgan Stanley",
  "keywords": [
    "gatsby"
  ],
  "dependencies": {
    "@morganstanley/gatsby-theme-ms-gh-pages": "^1.2.4",
    "gatsby": "^5.16.1"
  },
  "scripts": {
    "develop": "gatsby develop -H 0.0.0.0",
    "start": "gatsby develop -H 0.0.0.0",
    "build": "gatsby clean && gatsby build --prefix-paths && npm run pub",
    "serve": "gatsby serve",
    "pub": "rimraf ../docs && mv public ../docs",
    "clean": "gatsby clean"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "lmdb@2.5.2": true,
    "lmdb@2.5.3": true,
    "@parcel/watcher@2.5.6": true,
    "core-js@3.48.0": true,
    "core-js-pure@3.48.0": true,
    "es5-ext@0.10.64": true,
    "gatsby@5.16.1": true,
    "gatsby-cli@5.16.0": true,
    "msgpackr-extract@3.0.3": true,
    "sharp@0.32.6": true
  }
}
